# Copy to ops/studio.env on the Mac mini (that file is not committed). No passwords or tokens go here.
# Cloudflare Access, from Zero Trust > Access > Applications > your review application:
REGSTUDIO_ACCESS_TEAM=your-team-name          # as in your-team-name.cloudflareaccess.com
REGSTUDIO_ACCESS_AUD=                         # the Application Audience (AUD) tag
# Public address of the site, used in the digest email and feeds
# REGSTUDIO_SITE_URL=https://your-domain

# Mail through Gmail (pipeline/regstudio/mailer.py). Connect once with:
#   regstudio mail-setup --client ~/Downloads/credentials.json
# REGSTUDIO_MAIL_FROM=mahak.mittal@joulewise.com      # the account that signs in; mail is sent as this address
# REGSTUDIO_MAIL_SALES=sales@joulewise.com            # where project requests and chat contacts go
# REGSTUDIO_MAIL_REVIEW=lawyer1@urjapraxis.com,lawyer2@urjapraxis.com   # "waiting for review" note after each scan

# Senior reviewers are chosen on the review site's Admin page (Review role). This line is only for people who sign in
# on this Mac itself (local password or Cloudflare Access): their emails, comma-separated. Empty by default.
# REGSTUDIO_SENIOR_REVIEWERS=
