# Copy to ops/studio.env on the Mac mini (that file is not committed). No passwords or tokens go here.
# Cloudflare Access, from Zero Trust > Access > Applications > your review application:
REGSTUDIO_ACCESS_TEAM=your-team-name          # as in your-team-name.cloudflareaccess.com
REGSTUDIO_ACCESS_AUD=                         # the Application Audience (AUD) tag
# Public address of the site, used in the digest email and feeds
# REGSTUDIO_SITE_URL=https://your-domain
