<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The publisher: every 10 minutes, push newly approved items to the public site. Does nothing when nothing changed.
     Installed by ops/install_mac.sh, which replaces REPO_PATH. Do not load this file as it is. -->
<plist version="1.0"><dict>
  <key>Label</key><string>in.joulewise.regstudio.deploy</string>
  <key>ProgramArguments</key><array><string>/bin/zsh</string><string>-lc</string><string>cd REPO_PATH &amp;&amp; source .venv/bin/activate &amp;&amp; { [ -f ops/studio.env ] &amp;&amp; set -a &amp;&amp; source ops/studio.env; set +a; }; exec regstudio deploy</string></array>
  <key>StartInterval</key><integer>600</integer>
  <key>StandardOutPath</key><string>REPO_PATH/data/store/logs/deploy.out</string>
  <key>StandardErrorPath</key><string>REPO_PATH/data/store/logs/deploy.err</string>
</dict></plist>
