{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Digest output",
  "description": "One weekly edition. Every key point, number, chart item and dated note cites a paragraph id of a document in the edition.",
  "type": "object",
  "required": ["intro", "order"],
  "additionalProperties": false,
  "$defs": {
    "doc": {"type": "string", "minLength": 8, "description": "id (or its first 8+ characters) of a document in this edition"},
    "pid": {"type": "string", "pattern": "^p[0-9]+\\.[0-9]+$"}
  },
  "properties": {
    "intro": {"type": "string", "maxLength": 1200, "description": "the lead: what a power-sector reader should not miss this week"},
    "order": {"type": "array", "items": {"$ref": "#/$defs/doc"}, "description": "the items in the edition, most significant first; items left out are not in the edition"},
    "key_points": {"type": "array", "maxItems": 6, "items": {"type": "object", "required": ["text", "basis"], "additionalProperties": false, "properties": {
      "text": {"type": "string", "maxLength": 320},
      "basis": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"type": "object", "required": ["doc", "pid"], "additionalProperties": false,
                "properties": {"doc": {"$ref": "#/$defs/doc"}, "pid": {"$ref": "#/$defs/pid"}}}}}}},
    "numbers": {"type": "array", "maxItems": 8, "items": {"type": "object", "required": ["value", "label", "doc", "pid"], "additionalProperties": false, "properties": {
      "value": {"type": "string", "maxLength": 24, "description": "the figure as it should be shown, e.g. 'Rs 9.99/kWh' or '3,200 MW'"},
      "label": {"type": "string", "maxLength": 140},
      "doc": {"$ref": "#/$defs/doc"}, "pid": {"$ref": "#/$defs/pid"}}}},
    "charts": {"type": "array", "maxItems": 3, "items": {"type": "object", "required": ["type", "title", "items"], "additionalProperties": false, "properties": {
      "type": {"enum": ["bars", "series", "timeline"]},
      "title": {"type": "string", "maxLength": 90}, "unit": {"type": "string", "maxLength": 16}, "note": {"type": "string", "maxLength": 240},
      "items": {"type": "array", "minItems": 2, "maxItems": 10, "items": {"type": "object", "required": ["label", "doc", "basis"], "additionalProperties": false, "properties": {
        "label": {"type": "string", "maxLength": 60}, "value": {"type": "number"}, "start": {"type": "string"}, "end": {"type": "string"},
        "tag": {"type": "string", "maxLength": 40}, "context": {"type": "boolean"},
        "doc": {"$ref": "#/$defs/doc"}, "basis": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"$ref": "#/$defs/pid"}}}}}}}},
    "watch": {"type": "array", "maxItems": 8, "items": {"type": "object", "required": ["date", "text"], "additionalProperties": false, "properties": {
      "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}, "text": {"type": "string", "maxLength": 200},
      "doc": {"$ref": "#/$defs/doc"}, "pid": {"$ref": "#/$defs/pid"}}}}
  }
}
