{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A simple commercial illustration (beta)",
  "description": "A worked example. Every input comes from the document (basis) or is an assumption with its reason. Steps use + - * / and brackets over input and earlier step ids; code does the arithmetic. The takeaway quotes results only through {step_id} slots and contains no digits of its own.",
  "type": "object",
  "required": ["title", "question", "inputs", "steps", "takeaway"],
  "additionalProperties": false,
  "properties": {
    "title": {"type": "string", "maxLength": 90},
    "question": {"type": "string", "maxLength": 200, "description": "the commercial question, in plain words, e.g. 'What does 100 MW of this supply cost a discom in a year?'"},
    "inputs": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "object", "required": ["id", "label", "value"], "additionalProperties": false, "properties": {
      "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,23}$"},
      "label": {"type": "string", "maxLength": 80},
      "value": {"type": "number"},
      "unit": {"type": "string", "maxLength": 16},
      "basis": {"type": "array", "maxItems": 3, "items": {"type": "string", "pattern": "^p[0-9]+\\.[0-9]+$"}},
      "assumption": {"type": "string", "maxLength": 240, "description": "required when the value is not stated in the document: why this value"}}}},
    "steps": {"type": "array", "minItems": 1, "maxItems": 6, "items": {"type": "object", "required": ["id", "label", "expr"], "additionalProperties": false, "properties": {
      "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,23}$"},
      "label": {"type": "string", "maxLength": 100},
      "expr": {"type": "string", "maxLength": 200},
      "unit": {"type": "string", "maxLength": 16},
      "decimals": {"type": "integer", "minimum": 0, "maximum": 2}}}},
    "takeaway": {"type": "string", "maxLength": 300},
    "caveats": {"type": "array", "maxItems": 3, "items": {"type": "string", "maxLength": 200}}
  }
}
