{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Impact assessment",
  "description": "No scores. Every statement cites paragraph ids from the document text; statements without a valid citation are dropped.",
  "type": "object",
  "required": ["market_note", "key_points", "procurement", "stakeholders", "open_questions"],
  "additionalProperties": false,
  "properties": {
    "market_note": {"type": "string", "maxLength": 500, "description": "two or three sentences: the mechanism that changes, who is exposed, and the figure that matters"},
    "key_points": {"type": "array", "maxItems": 5, "items": {"$ref": "#/$defs/point"}},
    "procurement": {"type": "array", "maxItems": 6, "items": {"$ref": "#/$defs/point"},
                    "description": "requirements created or changed: obligations, quantities, eligibility, bidding rules, contract terms, deadlines"},
    "stakeholders": {
      "type": "object", "additionalProperties": false,
      "description": "only the groups the text actually affects",
      "properties": {
        "discoms": {"$ref": "#/$defs/cell"}, "ci_consumers": {"$ref": "#/$defs/cell"}, "captive": {"$ref": "#/$defs/cell"},
        "re_developers": {"$ref": "#/$defs/cell"}, "storage": {"$ref": "#/$defs/cell"}, "conventional": {"$ref": "#/$defs/cell"},
        "transmission": {"$ref": "#/$defs/cell"}, "traders": {"$ref": "#/$defs/cell"}
      }
    },
    "open_questions": {"type": "array", "maxItems": 3, "items": {"type": "string", "maxLength": 240},
                       "description": "what the text leaves open and a reader should check before acting"}
  },
  "$defs": {
    "basis": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"type": "string", "pattern": "^p[0-9]+\\.[0-9]+$"}},
    "point": {"type": "object", "required": ["text", "basis"], "additionalProperties": false,
              "properties": {"text": {"type": "string", "maxLength": 280}, "basis": {"$ref": "#/$defs/basis"}}},
    "cell": {"type": "object", "required": ["effect", "comment", "basis"], "additionalProperties": false,
             "properties": {"effect": {"enum": ["opportunity", "cost", "mixed"], "description": "direction only, not a score"},
                            "comment": {"type": "string", "maxLength": 360, "description": "what changes for this group, through which mechanism, with the figure from the text"},
                            "basis": {"$ref": "#/$defs/basis"}}}
  }
}
