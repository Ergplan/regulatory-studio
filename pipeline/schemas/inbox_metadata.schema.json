{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Inbox metadata",
  "description": "Written by the download script beside every PDF in data/inbox/<commission>/<YYYY-MM-DD>/.",
  "type": "object",
  "required": ["commission", "doc_type", "source_url", "downloaded_at", "sha256"],
  "additionalProperties": false,
  "properties": {
    "commission": {"enum": ["cerc", "aptel", "uperc", "merc", "gerc", "kerc", "rerc", "tnerc"]},
    "doc_type": {"enum": ["order", "judgment", "regulation", "amendment", "draft"]},
    "source_url": {"type": "string", "minLength": 8},
    "downloaded_at": {"type": "string", "minLength": 10},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "title": {"type": "string"},
    "doc_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "case_number": {"type": "string"},
    "comment_deadline": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "drafts: last date for comments"},
    "hearing_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "drafts: public hearing date"},
    "related": {"type": "array", "description": "drafts: public notice, explanatory memorandum and other papers",
                "items": {"type": "object", "required": ["label", "url"], "additionalProperties": false,
                          "properties": {"label": {"type": "string"}, "url": {"type": "string"}}}}
  }
}
